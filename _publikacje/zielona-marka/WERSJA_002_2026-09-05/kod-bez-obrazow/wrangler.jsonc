{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zielona-marka",
  "account_id": "e706b41950d232c8fd95da6db0ac0d88",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "zielona-marka.pl/*",
      "zone_name": "zielona-marka.pl"
    },
    {
      "pattern": "www.zielona-marka.pl/*",
      "zone_name": "zielona-marka.pl"
    }
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zielona-marka-db",
      "database_id": "19eab308-f2a5-49c3-b122-9fde4d2907ac",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
