{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zielona-marka",
  "keep_vars": true,
  "vars": { "INQUIRY_FORM_ENABLED": "1" },
  "account_id": "e706b41950d232c8fd95da6db0ac0d88",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    { "name": "ZM_LOGIN_RATE_LIMITER", "namespace_id": "134653837501", "simple": { "limit": 10, "period": 60 } },
    { "name": "ZM_INQUIRY_RATE_LIMITER", "namespace_id": "134653837502", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "routes": [
    {
      "pattern": "zielona-marka.pl/*",
      "zone_name": "zielona-marka.pl"
    },
    {
      "pattern": "www.zielona-marka.pl/*",
      "zone_name": "zielona-marka.pl"
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zielona-marka-db",
      "database_id": "19eab308-f2a5-49c3-b122-9fde4d2907ac",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "cache": { "enabled": true }
}
